# Copy to .env for local dev, and add the same variables in Vercel:
# Project Settings -> Environment Variables (Production + Preview).

# --- Database / backend (Supabase) ---
# Client-side (safe to expose, must keep the VITE_ prefix)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side (same values, no VITE_ prefix)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Secret — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Site password gate ---
SITE_PASSWORD=
# Random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# --- Integrations ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DISCORD_WEBHOOK_URL=
COMBOWICK_KEY_ADMIN_TOKEN=

# --- Optional: protects cron/maintenance endpoints ---
LOVABLE_CRON_SECRET=
